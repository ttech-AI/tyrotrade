# tyroTrade — ortam değişkenleri (hepsi OPSİYONEL; kod içinde çalışan varsayılanlar gömülü)
# Kopyala: cp .env.example .env  — .env gitignore'ludur.

# Azure AD (Entra ID) SPA app registration. Varsayılan: "TYRO Trade Web App"
# kaydı (SPA client ID'leri gizli değildir, bundle'a gömülür).
# DİKKAT: lokal gelistirmede login calissin diye app registration'in SPA Redirect
# URI listesinde http://localhost:5173 de bulunmali (prod URI'lari zaten ekli).
#VITE_MSAL_TENANT_ID=9efa3bdf-67ad-47e3-8dfb-d1df79a6d7fa
#VITE_MSAL_CLIENT_ID=31e375e5-7aa7-4bd6-b6f0-96968f8360f8

# Launcher verilerinin (tyro_launcherapp tablosu) okunduğu Dataverse ortamı.
# Varsayılan: TYRO ortamı. tyroTrade kendi ortamına geçtiğinde burayı değiştir.
#VITE_DATAVERSE_URL=https://tyro.crm4.dynamics.com

# Copilot Studio chat ortamı (chat ekranındaki agent'lar bu ortamdan çağrılır).
#VITE_COPILOT_ENVIRONMENT_ID=Default-9efa3bdf-67ad-47e3-8dfb-d1df79a6d7fa

# Agent ikonlarını çekmek için Global Discovery yerine tek bir Dataverse
# ortamını hedeflemek istersen (opsiyonel optimizasyon):
#VITE_COPILOT_DATAVERSE_URL=

# ── Freight sayfaları (Sefer Takibi / E.M Bakış / Veri Yönetimi) ─────────
# Bu sayfaların okuduğu D365 F&O sanal tabloları (mserp_*) launcher'ın
# ortamında DEĞİL, operasyon ortamındadır. Ayrı kaynak = ayrı token; aynı
# tenant ve aynı hesap olduğu için ek giriş gerekmez.
#VITE_FREIGHT_DATAVERSE_URL=https://operations-tiryaki.crm4.dynamics.com

# Gemi AIS pozisyonlarını çeken Cloudflare Worker proxy'si. Tanımsızsa
# haritadaki "canlı konum" düğmesi çalışmaz; rota, seferler ve kartlar
# bundan etkilenmez.
VITE_VESSEL_WORKER_URL=https://noisy-smoke-b37a.pinarkrtnloglu.workers.dev

# Sessiz SSO (prompt=none) kill-switch: 1 yapılırsa açılışta sessiz giriş
# denemesi tamamen kapanır. Tek ziyaret için alternatifi URL'e ?nosso=1 eklemektir.
#VITE_DISABLE_SILENT_SSO=1
